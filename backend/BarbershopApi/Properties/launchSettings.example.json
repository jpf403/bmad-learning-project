{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5290",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Jwt__Key": "replace-with-a-random-string-at-least-32-characters-long",
        "AdminSeed__Email": "replace-with-admin-email@example.com",
        "AdminSeed__Password": "replace-with-admin-password",
        "ZPaxSso__ClientId": "replace-with-zpax-client-id",
        "ZPaxSso__ClientSecret": "replace-with-zpax-client-secret"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://localhost:7113;http://localhost:5290",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Jwt__Key": "replace-with-a-random-string-at-least-32-characters-long",
        "AdminSeed__Email": "replace-with-admin-email@example.com",
        "AdminSeed__Password": "replace-with-admin-password",
        "ZPaxSso__ClientId": "replace-with-zpax-client-id",
        "ZPaxSso__ClientSecret": "replace-with-zpax-client-secret"
      }
    }
  }
}
